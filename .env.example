# Copy this file to .env and adjust for your environment.
# Never commit the real .env file — it's already in .gitignore.

# Logging verbosity: debug | info | warning | error
LOG_LEVEL=info

# Directory containing catboost_model.joblib, feature_engineer.joblib,
# segment_profiles.json. Change this if you deploy models separately
# from application code (common in larger MLOps setups).
MODELS_DIR=models
